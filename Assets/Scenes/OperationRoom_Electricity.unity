  m_Script: {fileID: 11500000, guid: 744bbe924340f1d4b8c06573fc6ab254, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhoneHandler
  generatorId: generator_01
  npcVoiceManager: {fileID: 583899172}
  player: {fileID: 596906172}
  phoneDialogueLines:
  - Hello?
  - Can you hear me?
  - You turned the power back on, right?
  - Listen to me.
  - The things they did in here.
  - The things they have done to US.
  - I have been trapped in this hell for a long time.
  - I've been looking for a way out, but i just could not find it.
  - You are the last missing piece of my little puzzle.
  - But you have the devil in your head.
  - Everybody had, but they all burn in hell now.
  - Before we get out, I must help you get rid of the devil.
  - DON'T you dare do anything, just wait for me there.
  - I will FREE you from that VOICE!
  - Trust me
  typingSpeed: 0.05
  displayDuration: 3
  timeBetweenLines: 1
  promptText: Answer
  audioSource: {fileID: 461573940}
  ringClip: {fileID: 8300000, guid: 02ff3103d800c8f42aa3e2c674d36813, type: 3}
  ringInterval: 1.3
